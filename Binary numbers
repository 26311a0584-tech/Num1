#include <stdio.h>

int main() {
    int n,r;
    int BN = 0, place =1;
    
    scanf("%d", &n);
    if (n == 0){
        BN = 0;
    }
    else{
        while(n == 0){
            r=n%2;
            BN += r*place;
            n = n/2;
            place = place*10;
        }
        
    }
 printf("%d\n",BN);
 return 0;
    
    
    
    

}
