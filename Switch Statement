

include <stdio.h>
int main(){
    
    int a,b;
    char opr;
    
    scanf("%d %d %c", &a, &b, &opr);
    
    switch(opr){
        case'+':
            printf("%d\n", a+b);
            break;
        case'-':
            printf("%d\n", a-b);
            break;
        case'*':
            printf("%d\n", a*b);
            break;
        case'/':
            printf("%d\n", a/b);
            break;
        case'%':
            printf("%d\n", a%b);
            break;
            
        default:
            printf("Invalid operator");
    }
    return 0;
}
