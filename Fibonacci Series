#include <stdio.h>

int main() {
	 int N;
	 scanf("%d ",&N);
	 int fib1 = 0, fib2=1;
	 for (int i=0; i<N; i++){
	     if(i==0)
	   {
	       printf("%d ", fib1);
	   }
	   else if (i==1){
	       printf("%d ", fib2);
	       
	   }
	   else{
	       int fib = fib1 + fib2;
	       printf("%d ",fib);
	       fib1 = fib2;
	       fib2 = fib;
	   }
	   
	   
	 }
	 printf("\n ");
	 return 0;



}
